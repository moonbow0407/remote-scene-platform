# 复制为 .env 后按需修改口令。日常联调和 Compose 共用这一份。
# - 本机 `uv run` / ./scripts/dev.sh：直接用下面的 127.0.0.1 映射端口
# - Compose 全栈容器：compose.yaml 会覆盖为 db / minio / rabbitmq / titiler
# 本文件只用于本机开发，所有服务不得暴露公网。
#
# PostGIS 映射 55432，避开 Windows PostgreSQL 15 占用的 5432。

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=remote_scene
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app

APP_DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:55432/remote_scene
APP_MINIO_ENDPOINT=127.0.0.1:9000
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin
APP_MINIO_BUCKET=remote-scene
APP_MINIO_SECURE=false
APP_RABBITMQ_URL=amqp://app:app@127.0.0.1:5672/
APP_RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
APP_RABBITMQ_MANAGEMENT_USER=app
APP_RABBITMQ_MANAGEMENT_PASSWORD=app
APP_TITILER_URL=http://127.0.0.1:8081
APP_LOG_LEVEL=INFO

# 预签名 URL 的外部端点（浏览器经端口映射访问；仅回环）
APP_MINIO_PUBLIC_ENDPOINT=localhost:9000
# 本机 uv 进程走 :8000；Compose 全栈由 compose.yaml 覆盖为 http://localhost:8080
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000
# 瓦片令牌签名密钥（本机开发值；生产必须更换并经环境注入）
APP_TILE_TOKEN_SECRET=dev-only-tile-secret-change-me
# JWT 签名密钥与 TTL（本机开发值；生产必须更换，禁止空密钥）
APP_JWT_SECRET=dev-only-jwt-secret-change-me
APP_ACCESS_TOKEN_TTL_SECONDS=3600
APP_REFRESH_TOKEN_TTL_SECONDS=604800
# Geo Worker 临时目录（本机路径；Compose Worker 由 compose.yaml 覆盖为 /data/tmp）
APP_WORKER_TMP_DIR=/tmp/remote-scene-worker
APP_WORKER_TMP_MIN_RATIO=2.0
APP_WORKER_CONCURRENCY=2
# 单任务软/硬时限；硬时限需大于软时限，为状态落库与临时目录清理留窗口
APP_WORKER_TASK_SOFT_TIMEOUT_SECONDS=21600
APP_WORKER_TASK_HARD_TIMEOUT_SECONDS=22200
APP_ASSET_RETENTION_DAYS=7
APP_CLEANUP_POLL_SECONDS=5
APP_CLEANUP_BATCH_SIZE=20
