{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "Outbox backlog",
      "targets": [{"expr": "remote_scene_outbox_backlog", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "RabbitMQ queue depth",
      "targets": [{"expr": "sum(remote_scene_rabbitmq_queue_depth)", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "stat",
      "title": "Job failures (24h)",
      "targets": [{"expr": "remote_scene_job_failures_24h", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0}
    },
    {
      "type": "gauge",
      "title": "Worker utilization",
      "targets": [{"expr": "remote_scene_worker_utilization_ratio", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Job processing duration",
      "targets": [{"expr": "remote_scene_job_duration_seconds", "legendFormat": "{{aggregation}}", "refId": "A"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}
    },
    {
      "type": "timeseries",
      "title": "Storage usage",
      "targets": [{"expr": "remote_scene_storage_bytes", "legendFormat": "{{kind}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}
    },
    {
      "type": "stat",
      "title": "Cleanup backlog",
      "targets": [{"expr": "remote_scene_cleanup_backlog", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 14}
    },
    {
      "type": "timeseries",
      "title": "HTTP error rate",
      "targets": [{"expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 14}
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 14}
    },
    {
      "type": "stat",
      "title": "Operational collectors",
      "targets": [{"expr": "remote_scene_operational_collector_up", "legendFormat": "{{component}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 14}
    }
  ],
  "schemaVersion": 39,
  "tags": ["remote-scene", "stage6"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Remote Scene Operations",
  "uid": "remote-scene-ops",
  "version": 1
}
